# Loaded automatically by scripts/p6_local.py. Paths resolve from repository root.
# Personal overrides belong in ignored .env.p6.local; no exports are needed.
P6_BACKEND=ollama
P6_MODEL=qwen3:14b
P6_OLLAMA_BASE=http://127.0.0.1:11434
P6_OLLAMA_CONTEXT=8192
P6_MAX_NEW_TOKENS=1024
P6_API_HOST=127.0.0.1
P6_API_PORT=8000
P6_UI_PORT=8501
P6_PIPELINE=adaptive
P6_TOP_K=5
# Apple GPU for one-time corpus encoding; runtime retrieval stays on CPU.
P6_INDEX_DEVICE=mps
P6_P3_REF=origin/p3-qasper-foundation
PAPERGAP_CORPUS=data/processed/passages.jsonl
PAPERGAP_DENSE_INDEX=indexes/p6-development-bge
HF_HOME=.cache/huggingface
DEMO_AGENT_CACHE_FOLDER=.cache/huggingface/hub
DEMO_AGENT_DEVICE=cpu
# Runtime loads only prepared pinned BGE snapshots; setup can download them.
DEMO_AGENT_OFFLINE=1
DEMO_AGENT_BGE=1
DEMO_AGENT_SCOPED=1
DEMO_AGENT_MAX_RETRIES=2
DEMO_AGENT_CANDIDATE_K=20
P5_API_BASE=http://127.0.0.1:8000
P5_RECORDS_PATH=results/p6-local/demo-records.jsonl
P6_SAMPLES_PATH=results/p6-local/sample-questions.jsonl
P6_PAPER_CATALOG_PATH=data/processed/p6-paper-catalog.json
P5_ANSWER_TIMEOUT=900
# Blank for loopback local service; remote GPU API must use a shared bearer token.
P5_API_TOKEN=
P5_AUTH_HEADER=
P5_AUTH_SCHEME=
