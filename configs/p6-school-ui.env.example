# Future Mac UI overrides. Copy to ignored .env.p6.school-ui.
# First tunnel Mac port 8000 to the allocated compute node's API port 18080.
# P6_CONFIG_FILE=.env.p6.school-ui ./scripts/p6-local.sh remote
P5_API_BASE=http://127.0.0.1:8000
P5_API_TOKEN=REPLACE_WITH_THE_SAME_PRIVATE_SHARED_TOKEN
P5_AUTH_HEADER=Authorization
P5_AUTH_SCHEME=Bearer
