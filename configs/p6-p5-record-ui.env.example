# Connect the Mac UI to the existing record-only API described in P5's guide.
# Copy to ignored .env.p6.p5-ui and enter the API operator's current shared token.
# Start the SSH tunnel to the actual running compute node first.
# P6_CONFIG_FILE=.env.p6.p5-ui ./scripts/p6-local.sh remote
# This starts only Streamlit. It cannot add retrieval/agent execution to the API.
P5_API_BASE=http://127.0.0.1:8000
P5_API_TOKEN=REPLACE_WITH_EXISTING_P5_SERVER_TOKEN
P5_AUTH_HEADER=Authorization
P5_AUTH_SCHEME=Bearer
P5_ANSWER_TIMEOUT=900
# Download P5's original input state to this Mac path; not an answer capture.
P5_RECORDS_PATH=results/p6-school/p5-state-smoke.jsonl
